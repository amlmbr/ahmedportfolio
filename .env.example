# Ahmed AI assistant — environment configuration
#
# Local Ollama demo (Mode A): the values below are the defaults and work as-is
# when Ollama runs on your laptop. No .env file is required locally.
#
# Vercel (Mode B): on the public deployment localhost is unreachable, so the
# assistant automatically falls back to grounded knowledge-base mode. If you
# later expose a SECURED, reachable Ollama-compatible endpoint, set
# OLLAMA_BASE_URL to it in the Vercel project environment variables and the same
# backend will stream Llama answers — no code change needed.

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
